# ── Pulse LDN — Apache config ────────────────────────────────────────────────

# ── MIME types ───────────────────────────────────────────────────────────────
AddType text/html             .html
AddType text/css              .css
AddType application/javascript .js
AddType application/json      .json
AddType image/svg+xml         .svg
AddType image/webp            .webp
AddType image/x-icon          .ico

# ── Compression ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# ── Cache headers ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML — short cache so updates go live quickly
  ExpiresByType text/html             "access plus 1 hour"
  # Versioned assets (style.css?v=4, app.js?v=2) — long cache is fine
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # Data file updated on each fetch_data.py run
  ExpiresByType application/json      "access plus 1 hour"
  # Images and fonts
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Custom 404 ────────────────────────────────────────────────────────────────
ErrorDocument 404 /index.html

# ── Block dotfiles from being served ─────────────────────────────────────────
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
